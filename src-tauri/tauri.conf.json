{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 会话中枢",
  "version": "0.1.0",
  "identifier": "com.yi.aisessionhub",
  "build": {
    "beforeDevCommand": "node ../server.js",
    "devUrl": "http://localhost:54321",
    "beforeBuildCommand": "echo tauri-build",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 会话中枢",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": ["../server.js", "../src/*", "../sessions.json"]
  }
}
